APP_NAME=CharmingDeviceAPI
DEBUG=true
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=你的密码
POSTGRES_DATABASE=charming
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_me_to_a_long_random_value
REDIS_DB=0
WECHAT_APP_ID=xxxxx
WECHAT_APP_SECRET=xxxx
JWT_SECRET_KEY=请替换成足够长的随机字符串
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
PUBLIC_BASE_URL=https://your-public-domain.example.com

# 大模型配置
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=你的火山方舟API_KEY
ARK_DOUBAO_MODEL=你的方舟豆包模型ID
ARK_DEEPSEEK_MODEL=你的方舟DeepSeek模型ID

# 硬件语音链路固定使用的大模型（不随智能体 model_key 变化，需带方舟版本号后缀）
HARDWARE_LLM_MODEL=deepseek-v4-1-flash-260910
# 写进系统提示词的模型名，用户问"你是什么模型"时按它回答
HARDWARE_LLM_LABEL=DeepSeek-V4.1-Flash

# 千问配置；不使用千问时可以留空
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# 千问实时语音：联网搜索由模型自主决定是否调用，可设为 false 关闭
QWEN_AUDIO_REALTIME_ENABLE_SEARCH=true

# 向量模型（走标准 OpenAI 兼容接口，换供应商只改下面三行）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 留空则自动复用上面的 QWEN_API_KEY
EMBEDDING_API_KEY=
# 必须与 Milvus Collection 的向量维度一致。改动此值 = 必须重建 Collection
# 并重新灌入全部历史数据（不同模型的向量空间不兼容，不能混用）。
EMBEDDING_DIMENSION=1024
MILVUS_SUMMARY_COLLECTION=conversation_summary_v1
MILVUS_KNOWLEDGE_COLLECTION=knowledge_chunks_v1
KNOWLEDGE_PARSER_VERSION=manual-v1
KNOWLEDGE_CHUNKER_VERSION=element-overlap-v1
KNOWLEDGE_EMBEDDING_PROFILE=kb-text-v1
KNOWLEDGE_CHUNK_TARGET_CHARS=800
KNOWLEDGE_CHUNK_OVERLAP_CHARS=100
KNOWLEDGE_RETRIEVAL_TOP_K=5

# 知识库源文件使用私有 COS 桶；服务端密钥只填写在服务器 .env 中。
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SECURITY_TOKEN=
KNOWLEDGE_FILE_PARSER_VERSION=docx-v1
# 普通单 AZ 桶使用 STANDARD，多 AZ 桶使用 MAZ_STANDARD。
KNOWLEDGE_COS_STORAGE_CLASS=STANDARD
KNOWLEDGE_MAX_FILE_BYTES=10485760
KNOWLEDGE_MAX_DOCUMENTS_PER_BASE=10
KNOWLEDGE_MAX_BASE_CONTENT_BYTES=104857600

# Milvus 地址（对话摘要长期记忆）。注意：容器内的 127.0.0.1 指容器自己！
# 本地开发：Milvus 走 infra/docker-compose.yml，19530 映射到宿主机，用这个：
MILVUS_URI=http://127.0.0.1:19530
# 线上部署：Milvus 走 infra/compose.milvus.prod.yml，与 backend 同在
# charmrobo_default 网络内，且 19530 **没有**映射到宿主机，必须用服务名：
# MILVUS_URI=http://standalone:19530
